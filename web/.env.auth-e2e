# Build-time config for the auth e2e Playwright suite (playwright.auth.config.ts).
# These are dummy values — all Cognito traffic is stubbed via page.route() in
# the tests, so no real user pool is contacted. VITE_MOCK is forced to 0 by
# vite.config.ts for any non-"mock" mode, so the real auth path runs.
VITE_SIM_ID=melb
VITE_API_BASE_URL=https://auth-e2e.example.invalid
VITE_COGNITO_REGION=ap-southeast-2
VITE_COGNITO_CLIENT_ID=authe2eclientid0000000000
