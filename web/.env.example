# Copy to .env.local and adjust. All values are optional in mock mode.

# Run entirely offline with the built-in fake state generator (recommended for
# a no-backend demo): login screen is skipped and no network calls are made.
VITE_MOCK=1

# Simulation identifier used in API paths (/v1/sim/{simId}/...)
VITE_SIM_ID=melb

# --- Live backend mode (set VITE_MOCK=0 or remove it) ---
# Base URL of the API Gateway HTTP API (no trailing slash). The client appends /v1/...
# VITE_API_BASE_URL=https://x7h1b78j89.execute-api.ap-southeast-2.amazonaws.com

# Cognito sign-in. The app authenticates at runtime (USER_PASSWORD_AUTH) and
# sends the fresh IdToken as `Authorization: Bearer <idToken>`. No static token
# is baked in (tokens expire in ~1h). The long-lived refresh token is persisted
# to localStorage so the session survives a page reload (silently refreshed via
# REFRESH_TOKEN_AUTH); the short-lived Id/Access JWTs are kept in memory only.
# Operators can change their password in-app (Cognito ChangePassword).
# VITE_COGNITO_REGION=ap-southeast-2
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional operator credentials for automatic sign-in on load, so the deployed
# demo "just works". If omitted (or if auto-login fails) the login screen is shown.
# VITE_OPERATOR_USER=operator
# VITE_OPERATOR_PASS=change-me

# Optional: poll interval in ms (must keep <=2000 to satisfy Req15.3). Default 1500.
# VITE_POLL_MS=1500
